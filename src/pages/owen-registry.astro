---

<Layout>
  <div class="p-5">
    <div
      class="grid grid-cols-1 md:grid-cols-[repeat(auto-fill,minmax(350px,1fr))] gap-8"
    >
      {
        entries.map((u) => {
          return (
            <a href={u.url}>
              <div class="flex flex-col gap-4">
                {u.image ? (
                  <img src={u.image} class="aspect-square" />
                ) : (
                  <div class="bg-gray-200 aspect-square flex items-center justify-center @container">
                    <i class="ph ph-image-broken text-[25cqi] text-gray-300" />
                  </div>
                )}
                <div>{u.name}</div>
              </div>
            </a>
          );
        })
      }
    </div>
  </div>
</Layout>
