---

<Layout>
  <div class="p-5">
    <h1 class="text-6xl mb-8">Welcome to Owie's List!</h1>
    <div
      class="grid grid-cols-1 md:grid-cols-[repeat(auto-fill,minmax(350px,1fr))] gap-10"
      data-registry={JSON.stringify(entries)}
    >
      {
        entries.map((u, i) => {
          return (
            <div class="flex flex-col items-center gap-4 h-full">
              <a target="_blank" href={u.url}>
                {u.image ? (
                  <img src={u.image} class="aspect-square" />
                ) : (
                  <div class="bg-gray-200 aspect-square flex items-center justify-center @container">
                    <i class="ph ph-image-broken text-[25cqi] text-gray-300" />
                  </div>
                )}
                <div class="flex justify-between">
                  <div class="text-xl">{u.name}</div>
                  <div class="text-xl">${u.price}</div>
                </div>
              </a>
              <div class="text-lg text-gray-600 italic flex-1">{u.note}</div>
              <button
                disabled={u.boughtBy}
                class:list={[
                  "bg-blue-400 rounded-md p-3 text-white max-w-90 w-full disabled:bg-gray-400",
                ]}
                data-index={i}
              >
                {u.boughtBy ? `Bought by ${u.boughtBy}` : "Buy for Owie!"}
              </button>
            </div>
          );
        })
      }
    </div>
  </div>
</Layout>
<script>
  import { actions } from "astro:actions";

  const registry = JSON.parse(
    document.querySelector<HTMLDivElement>("[data-registry]")?.dataset
      .registry || "[]",
  );
  const buttons = document.getElementsByTagName("button");
  for (const button of buttons) {
    const entryIndex = button.dataset.index
      ? parseInt(button.dataset.index)
      : -1;
    button.addEventListener("click", async () => {
      registry[entryIndex].boughtBy = "true";
      const ok = await actions.updateOwieRegistry({
        owieRegistryJson: JSON.stringify(registry),
      });
      if (ok) {
        button.innerText = "Bought!";
      }
    });
  }
</script>
