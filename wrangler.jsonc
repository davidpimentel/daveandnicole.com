{
  "name": "daveandnicole",
  "compatibility_date": "2026-10-30",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
  },
  "observability": {
    "enabled": true,
  },
  "kv_namespaces": [
    {
      "binding": "DANDN_KV", // The variable name used in your Worker code
      "id": "23a23712f02c46b48499bc5686878344", // The production KV namespace ID
    },
  ],
}
